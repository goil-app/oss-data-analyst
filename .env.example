# MongoDB: must be a read-only user (production refuses users with write privileges)
MONGODB_URI=mongodb+srv://querybot:<password>@cluster.mongodb.net

# AI Gateway: on Vercel auth is automatic (OIDC); locally use a key or `vercel env pull`
AI_GATEWAY_API_KEY=
# MODEL=openai/gpt-5.6-luna  (any AI Gateway model id, e.g. anthropic/claude-sonnet-5)

# Discord (Developer Portal > your app)
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
# Required: comma-separated server IDs allowed to use the bot. Empty = bot ignores everything
DISCORD_ALLOWED_GUILD_IDS=

# Chat SDK state (locks, dedupe), e.g. Upstash Redis
REDIS_URL=

# PostHog (optional): enables ExecutePostHog for backoffice/help center usage.
# Personal API key with only the `query:read` scope, restricted to the project
# POSTHOG_API_KEY=phx_...
# POSTHOG_PROJECT_ID=101112
# POSTHOG_HOST=https://eu.posthog.com

# Langfuse as data source (optional): enables ExecuteLangfuse over the backend's Langfuse project.
# Keys of THAT project (read with GET only); not the ones below, which trace this bot
# LANGFUSE_SOURCE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SOURCE_SECRET_KEY=sk-lf-...
# LANGFUSE_SOURCE_BASE_URL=https://cloud.langfuse.com

# Weekly report (Vercel Cron, Mondays 07:00 UTC): channel as discord:<guildId>:<channelId>.
# CRON_SECRET: any long random string; Vercel sends it as a Bearer token to the cron route
# WEEKLY_REPORT_CHANNEL_ID=discord:123:456
# CRON_SECRET=

# Extra PII field names to block/redact, on top of the defaults in src/lib/query-guard.ts
# PII_FIELDS=

# Langfuse tracing (optional)
# OBSERVABILITY_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
